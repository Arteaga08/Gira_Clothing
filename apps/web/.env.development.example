# Copiar a .env.development.local (git-ignored). Sin secretos: la URL del API
# no es sensible, por eso puede vivir en una variable NEXT_PUBLIC_*.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Llave PUBLICABLE de Stripe (pk_test_… / pk_live_…). Nunca la secreta (sk_…). Sin ella, el paso de pago dice «Pagos no disponibles».
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
