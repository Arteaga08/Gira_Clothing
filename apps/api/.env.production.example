# apps/api — production environment (placeholders only)
# Real values live in the host's secret manager, never in the repo.

NODE_ENV=production
PORT=4000

# MongoDB connection string (managed cluster, least-privilege user, IP allowlist)
MONGODB_URI=<mongodb+srv connection string>

# JWT signing secret — minimum 48 chars, distinct from every other environment
JWT_SECRET=<48+ random chars — openssl rand -hex 32>
JWT_EXPIRES_IN=7d

# AES-256-GCM key for encrypting secrets at rest (TOTP) — minimum 48 chars
ENCRYPTION_KEY=<48+ random chars — openssl rand -hex 32>

# Public web origin — MUST be https:// in production
CLIENT_URL=https://www.giraclothing.com

# Auth session cookie name
COOKIE_NAME=gira_session

# Pino log level
LOG_LEVEL=info

# Cloudinary (obligatorio en producción)
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=gira
