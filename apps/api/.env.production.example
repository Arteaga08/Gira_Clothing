# apps/api — production environment (placeholders only)
# Real values live in the host's secret manager, never in the repo.

NODE_ENV=production
PORT=4000

# MongoDB connection string (managed cluster, least-privilege user, IP allowlist)
MONGODB_URI=<mongodb+srv connection string>

# JWT signing secret — minimum 48 chars, distinct from every other environment
JWT_SECRET=<48+ random chars — openssl rand -hex 32>
JWT_EXPIRES_IN=7d

# AES-256-GCM key for encrypting secrets at rest (TOTP) — minimum 48 chars
ENCRYPTION_KEY=<48+ random chars — openssl rand -hex 32>

# Public web origin — MUST be https:// in production
CLIENT_URL=https://www.giraclothing.com

# Auth session cookie name
COOKIE_NAME=gira_session

# Pino log level
LOG_LEVEL=info

# Cuántos proxies inversos hay delante de la API. OBLIGATORIO ajustarlo al
# despliegue real: con 0 detrás de un proxy, Express ve siempre la IP del proxy,
# el limiter de login bloquea a todo el mundo tras 5 fallos y la auditoría
# guarda una IP inútil. Normalmente 1 (Railway/Render/Fly/Nginx); 2 si hay CDN
# delante del proxy. NUNCA poner `true`: haría falsificable el X-Forwarded-For
# y devolvería el control de los limiters al atacante.
TRUST_PROXY_HOPS=1

# Cloudinary (obligatorio en producción)
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=gira

# Stripe (obligatorio en producción)
# La publishable key NO va aquí: es del frontend (NEXT_PUBLIC_*), no del backend.
STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Ventana de tolerancia de la firma del webhook, en segundos (anti-replay). Default: 300
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Resend (obligatorio en producción)
RESEND_API_KEY=<re_...>
# Remitente verificado en Resend. Formato: correo@dominio o "Nombre <correo@dominio>"
MAIL_FROM=Gira Clothing <hola@giraclothing.mx>

# Telegram para avisos al equipo (SIEMPRE opcional; sin credenciales se usa un stub que loguea)
TELEGRAM_BOT_TOKEN=<123456:ABC-DEF...>
TELEGRAM_CHAT_ID=<-1001234567890>
