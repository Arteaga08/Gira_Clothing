# apps/api — development environment (placeholders only)
# Copy to .env.development.local and fill with real values. NEVER commit .local files.

NODE_ENV=development
PORT=4000

# MongoDB connection string (local instance in dev)
# From M3 onward this must point at a replica set (transactions require one) —
# see "Mongo local como replica set" in README.md.
MONGODB_URI=mongodb://127.0.0.1:27017/gira-dev?replicaSet=rs0

# JWT signing secret — minimum 48 chars. Generate with: openssl rand -hex 32
JWT_SECRET=<48+ random chars — openssl rand -hex 32>
JWT_EXPIRES_IN=7d

# AES-256-GCM key for encrypting secrets at rest (TOTP) — minimum 48 chars
ENCRYPTION_KEY=<48+ random chars — openssl rand -hex 32>

# Public web origin (used by CORS + verifyOrigin whitelist)
CLIENT_URL=http://localhost:3000

# Auth session cookie name
COOKIE_NAME=gira_session

# Pino log level: trace | debug | info | warn | error | silent
LOG_LEVEL=debug

# Interruptores de seguridad. Si se omiten valen `true` en TODO entorno.
# En local (http://localhost) hay que apagarlos: la cookie `Secure` no se guarda
# sobre http y los límites estorban al probar.
COOKIE_SECURE=false
RATE_LIMIT_ENABLED=false

# Cuántos proxies inversos hay delante de la API. En local: 0 (ninguno).
# Es un NÚMERO DE SALTOS, nunca `true`: decide qué IP ve Express, y de ahí
# dependen todos los rate limiters y la IP que guarda la bitácora de auditoría.
TRUST_PROXY_HOPS=0

# Cloudinary (obligatorio en producción; si se omite en dev/test se usa un adapter stub sin red)
CLOUDINARY_CLOUD_NAME=<cloud name>
CLOUDINARY_API_KEY=<api key>
CLOUDINARY_API_SECRET=<api secret>
CLOUDINARY_FOLDER=gira

# Stripe (obligatorio en producción; si se omite en dev/test se usa un adapter stub sin red)
# La publishable key NO va aquí: es del frontend (NEXT_PUBLIC_*), no del backend.
STRIPE_SECRET_KEY=<sk_test_... | sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>
# Ventana de tolerancia de la firma del webhook, en segundos (anti-replay). Default: 300
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# Resend (obligatorio en producción; si se omite en dev/test se usa un mailer stub sin red)
RESEND_API_KEY=<re_...>
# Remitente verificado en Resend. Formato: correo@dominio o "Nombre <correo@dominio>"
MAIL_FROM=Gira Clothing <hola@giraclothing.mx>

# Telegram para avisos al equipo (opcional en desarrollo; sin credenciales el aviso queda `skipped`)
TELEGRAM_BOT_TOKEN=<123456:ABC-DEF...>
TELEGRAM_CHAT_ID=<-1001234567890>

# Seed del administrador (solo lo lee src/scripts/seedAdmin.ts, no loadEnv()).
# El registro público siempre crea "customer": el primer admin sale de aquí.
# Alternativa sin dejarlo en disco: pnpm --filter @gira/api seed:admin -- --email ... --password ...
ADMIN_EMAIL=<correo del administrador>
ADMIN_PASSWORD=<contraseña fuerte del administrador>
ADMIN_NAME=Administrador

# --- Envía (envia.com): cotización, guías y rastreo ---
# Obligatorio en producción; si se omite en dev/test se usa un adapter stub sin red.
# El token de sandbox NO sirve en producción (y viceversa).
ENVIA_API_TOKEN=
# sandbox | production (default: sandbox fuera de producción, production en producción)
ENVIA_ENVIRONMENT=sandbox
# Paqueterías a cotizar (una llamada por cada una). Lista cerrada: estafeta,fedex,dhl,paquetexpress,redpack,ups
ENVIA_CARRIERS=estafeta,fedex,dhl,paquetexpress,redpack
# Opcional: secreto para verificar webhooks (se pide a soporte de Envía). Sin él el rastreo usa polling.
ENVIA_WEBHOOK_SECRET=
ENVIA_WEBHOOK_TOLERANCE_MS=300000

# Solo desarrollo: permite probar el webhook de rastreo contra el stub (firmado con este secreto).
STUB_SHIPPING_WEBHOOK_SECRET=
